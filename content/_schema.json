{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DailyNewsDay",
  "type": "object",
  "required": ["date", "timezone", "sections"],
  "properties": {
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "YYYY-MM-DD Asia/Shanghai calendar day" },
    "timezone": { "type": "string", "default": "Asia/Shanghai" },
    "subtitle": { "type": "string", "description": "Optional one-line under the date" },
    "footer": { "type": "string" },
    "quiet": { "type": "boolean", "description": "If true and all sections empty, still emit a quiet day page" },
    "sections": {
      "type": "object",
      "properties": {
        "research": { "$ref": "#/$defs/section" },
        "vendors": { "$ref": "#/$defs/section" },
        "radar": { "$ref": "#/$defs/section" },
        "clips": { "$ref": "#/$defs/clipsSection" }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "link": {
      "type": "object",
      "required": ["label", "url"],
      "properties": {
        "label": { "type": "string" },
        "url": { "type": "string" }
      }
    },
    "item": {
      "type": "object",
      "required": ["title", "gist"],
      "properties": {
        "title": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "meta": { "type": "string" },
        "subgroup": { "type": "string", "description": "Optional group label above this card (e.g. OpenAI)" },
        "gist": { "type": "string", "description": "One-line or short paragraph body" },
        "note": { "type": "string", "description": "为什么值得看" },
        "links": { "type": "array", "items": { "$ref": "#/$defs/link" } }
      }
    },
    "section": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "items": { "type": "array", "items": { "$ref": "#/$defs/item" } }
      }
    },
    "clipsSection": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "note": { "type": "string", "description": "Integration status / empty-day note" },
        "source": {
          "type": "object",
          "properties": {
            "repo": { "type": "string" },
            "path_pattern": { "type": "string" },
            "index": { "type": "string" }
          }
        },
        "items": { "type": "array", "items": { "$ref": "#/$defs/item" } }
      }
    }
  }
}
